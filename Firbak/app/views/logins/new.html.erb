<% content_for :title, "Log in · Firbak" %>

<div class="auth-shell">
  <div class="auth-stage">
    <aside class="auth-brand">
      <div>
        <span class="auth-brand-kicker">Firbak</span>
        <p class="auth-brand-title">Practice that sticks in class.</p>
        <p>Host live question sets, join with a code, and get feedback when it matters.</p>
      </div>
      <div class="auth-brand-footer">Built for instructors, TAs, and students</div>
    </aside>

    <div class="auth-card">
      <h1>Log in</h1>
      <p class="lede">Welcome back — continue hosting or join a session.</p>

      <%= form_with url: login_path, method: :post, local: true, class: "stack" do %>
        <div>
          <%= label_tag :email, "Email" %>
          <%= email_field_tag :email, params[:email], autocomplete: "email", required: true, placeholder: "you@tamu.edu" %>
        </div>
        <div>
          <%= label_tag :password, "Password" %>
          <%= password_field_tag :password, nil, autocomplete: "current-password", required: true %>
        </div>
        <%= submit_tag "Log in", class: "btn-block" %>
      <% end %>

      <p class="muted auth-footer-note">
        New here? <%= link_to "Create a student account", signup_path %>
      </p>
    </div>
  </div>
</div>

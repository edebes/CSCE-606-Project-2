<% content_for :title, "Question sets · Firbak" %>

<main class="page">
  <div class="panel">
    <div class="panel-head">
      <div>
        <h1>Question sets</h1>
        <p class="lede">Launch an in-class session from a prepared set, or edit a set’s title.</p>
      </div>
      <%= link_to "Join a session", join_session_path, class: "btn-secondary" %>
    </div>

    <% if @question_sets.any? %>
      <div class="table-wrap">
        <table>
          <thead>
            <tr>
              <th>Title</th>
              <th>Questions</th>
              <th></th>
            </tr>
          </thead>
          <tbody>
            <% @question_sets.each do |question_set| %>
              <tr>
                <td><strong><%= question_set.title %></strong></td>
                <td><%= pluralize(question_set.questions.count, "question") %></td>
                <td>
                  <div class="actions actions-tight">
                    <%= button_to "Start session",
                                  launch_session_question_set_path(question_set),
                                  method: :post,
                                  class: "btn-secondary" %>
                    <%= link_to "Edit", edit_question_set_path(question_set), class: "btn-ghost" %>
                  </div>
                </td>
              </tr>
            <% end %>
          </tbody>
        </table>
      </div>
    <% else %>
      <div class="empty-state">
        <p>No question sets available.</p>
      </div>
    <% end %>
  </div>
</main>

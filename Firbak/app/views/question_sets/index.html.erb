<h1>Question sets</h1>

<table>
  <thead>
    <tr>
      <th>Title</th>
      <th>Questions</th>
      <th></th>
    </tr>
  </thead>
  <tbody>
    <% @question_sets.each do |question_set| %>
      <tr>
        <td><%= question_set.title %></td>
        <td><%= question_set.questions.count %></td>
        <td>
          <%= button_to "Start session",
                        launch_session_question_set_path(question_set),
                        method: :post %>
        </td>
      </tr>
    <% end %>
  </tbody>
</table>

<% if @question_sets.empty? %>
  <p>No question sets available.</p>
<% end %>

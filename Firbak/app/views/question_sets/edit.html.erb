<% content_for :title, "Edit · #{@question_set.title} · Firbak" %>

<main class="page">
  <div class="panel panel-narrow">
    <div class="panel-head">
      <div>
        <h1>Edit question set</h1>
        <p class="lede">Update the title. Questions in this set are listed below.</p>
      </div>
      <%= link_to "← Back", question_sets_path, class: "btn-ghost" %>
    </div>

    <% if @question_set.errors.any? %>
      <div class="form-errors" role="alert">
        <p><%= pluralize(@question_set.errors.count, "error") %> prevented saving:</p>
        <ul>
          <% @question_set.errors.full_messages.each do |msg| %>
            <li><%= msg %></li>
          <% end %>
        </ul>
      </div>
    <% end %>

    <%= form_with model: @question_set, local: true, class: "stack" do |form| %>
      <div>
        <%= form.label :title, "Title" %>
        <%= form.text_field :title, required: true %>
      </div>
      <%= form.submit "Save changes", class: "btn-block" %>
    <% end %>

    <h2 class="section-title">Questions</h2>
    <% if @question_set.questions.any? %>
      <ol class="question-edit-list">
        <% @question_set.questions.order(:number, :id).each do |question| %>
          <li>
            <span class="question-edit-number">Q<%= question.number.presence || question.id %></span>
            <span class="question-edit-body"><%= question.body %></span>
          </li>
        <% end %>
      </ol>
      <p class="muted field-hint">Per-question editing is a separate backlog item.</p>
    <% else %>
      <div class="empty-state">
        <p>No questions in this set yet.</p>
      </div>
    <% end %>
  </div>
</main>

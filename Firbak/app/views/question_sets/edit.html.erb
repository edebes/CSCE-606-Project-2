<h1>Edit Question Set</h1>

<% if @question_set.errors.any? %>
  <div style="color: red;">
    <h2><%= pluralize(@question_set.errors.count, "error") %> prevented saving:</h2>
    <ul>
      <% @question_set.errors.full_messages.each do |msg| %>
        <li><%= msg %></li>
      <% end %>
    </ul>
  </div>
<% end %>

<%= form_with model: @question_set do |form| %>
  <div>
    <%= form.label :title %>
    <%= form.text_field :title %>
  </div>

  <hr>
<table>
  <thead>
    <tr>
      <th>Questions</th>
    </tr>
  </thead>
  <tbody>
    <% @question_set.questions.each do |question| %>
      <tr>
        <td><%= question.body %></td>
        <td>
          <%= button_to "Edit Question",
                        edit_question_set_path(question),
                        method: :get %>
        </td>
      </tr>
    <% end %>
  </tbody>
</table>

  <% end %>

<% content_for :title, "Session summary · Firbak" %>

<main class="page">
  <div class="session-card">
    <div class="panel-head">
      <div>
        <h1>Session summary</h1>
        <p class="lede"><%= @session.question_set.title %></p>
      </div>
      <%= link_to "Question sets", question_sets_path, class: "btn-ghost" %>
    </div>

    <div class="meta-row">
      <span class="pill muted">Code <%= @session.code %></span>
      <% unless @summary["answered"].to_i.zero? %>
        <span class="pill"><%= @summary["participant_count"].to_i %> participants</span>
      <% end %>
    </div>

    <% if @summary["answered"].to_i.zero? %>
      <div class="empty-state">
        <p>No answers were submitted in this session.</p>
      </div>
    <% else %>
      <p class="muted">
        <%= @summary["answered"] %> answers counted (first attempts only)
      </p>

      <h2 class="section-title">Most missed</h2>
      <ol id="most-missed">
        <% @summary["most_missed"].each do |question| %>
          <li>
            <%= question["body"] %>
            <span class="muted">(<%= question["missed"] %> of <%= question["answered"] %> missed)</span>
          </li>
        <% end %>
      </ol>

      <h2 class="section-title">Questions</h2>
      <% @summary.fetch("questions", []).each do |question| %>
        <section class="question-summary">
          <h3>Question <%= question["number"] %>: <%= question["body"] %></h3>
          <p class="muted"><%= question["correct"] %> of <%= question["answered"] %> correct</p>

          <div class="table-wrap">
            <table>
              <thead>
                <tr>
                  <th scope="col">Choice</th>
                  <th scope="col">Times chosen</th>
                  <th scope="col"></th>
                </tr>
              </thead>
              <tbody>
                <% question["choices"].each do |choice| %>
                  <tr>
                    <td><%= choice["body"] %></td>
                    <td><%= choice["count"] %></td>
                    <td>
                      <% if choice["correct"] %>
                        <span class="pill">Correct</span>
                      <% end %>
                    </td>
                  </tr>
                <% end %>
              </tbody>
            </table>
          </div>
        </section>
      <% end %>
    <% end %>
  </div>
</main>

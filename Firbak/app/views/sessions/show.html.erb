<h1>Live session</h1>

<p>
  Question set: <strong><%= @session.question_set.title %></strong>
</p>

<p>
  Join code: <strong><%= @session.code %></strong>
</p>

<p>Status: <%= @session.status %></p>

<% if current_user.role == "instructor" %>
  <table class="table table-striped col-md-12" id="movies">
    <thead>
      <tr>
        <th>User</th>
        <th>Current Question</th>
        <th>Struggling</th>
      </tr>
    </thead>
    <tbody>
      <% @session.participants.each do |participant| %>
        <tr>
          <td>
            <%= participant.name %>
          </td>
          <td>
            <%= @session.current_question_for(participant) %>
          </td>
          <td>
            <%= participant.struggling? %>
          </td>
        </tr>
      <% end %>
    </tbody>
  </table>
  <p>
    <%= link_to "End session", end_session_path(@session), method: :post, data: { confirm: "Are you sure you want to end the session?" }, class: "btn btn-danger" %>
  </p>
<% elsif current_user.role == "student" %>
  <% question = @session.current_question_for(current_user) %>
  <% if question.nil? %>
    <p>You have completed all questions in this session.</p>
  <% else %>
    <p>
      Current question: <strong><%= question.body %></strong>
    </p>
    <% question.choices.each do |choice| %>
      <%= form_with url: session_responses_path(@session), method: :post do |form| %>
        <%= form.hidden_field :question_id, value: question.id %>
        <%= form.hidden_field :choice_id, value: choice.id %>
        <%= form.submit choice.body, class: "btn btn-primary" %>
      <% end %>
    <% end %>
    <p>
      <%= link_to "Next question", session_path(@session), method: :get, class: "btn btn-secondary" %>
    </p>
  <% end %>
  <p>
    <%= link_to "Leave session", leave_session_path(@session), method: :post, data: { confirm: "Are you sure you want to leave the session?" }, class: "btn btn-danger" %>
  </p>
<% end %>

<%= link_to "Back to question sets", question_sets_path %>

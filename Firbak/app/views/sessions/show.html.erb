<h1>Live session</h1>

<p>
  Question set: <strong><%= @session.question_set.title %></strong>
</p>

<p>
  Join code: <strong><%= @session.code %></strong>
</p>

<p>Status: <%= @session.status %></p>

<% if @host_view %>
  <% if @session.active? %>
    <table class="table table-striped col-md-12" id="participants">
      <thead>
        <tr>
          <th>User</th>
          <th>Current Question</th>
          <th>Struggling</th>
        </tr>
      </thead>
      <tbody>
        <% @session.participants.where(role: "student").each do |participant| %>
          <tr>
            <td>
              <%= participant.name %>
            </td>
            <td>
              <% q = @session.current_question_for(participant) %>
              <%= q ? "Question #{q.number}" : "Completed" %>
            </td>
            <td>
              <%= participant.struggling?(@session) ? "Yes" : "No" %>
            </td>
          </tr>
        <% end %>
      </tbody>
    </table>
    <p>
      <%= button_to "Refresh", session_path(@session), method: :get, class: "btn btn-primary" %>
    </p>
    <% if @session.host_id == current_user.id %>
      <p>
        <%= button_to "End session", end_session_path(@session), method: :post, class: "btn btn-danger" %>
      </p>
    <% else %>
      <p>
        <%= button_to "Leave session", leave_session_path(@session), method: :post, class: "btn btn-danger" %>
      </p>
    <% end %>
  <% else %>
    <p>Session has ended.</p>
    <p><%= link_to "View session summary", summary_session_path(@session) %></p>
  <% end %>
<% else %>
  <% if @latest_response %>
    <% if @latest_response.correct %>
      <p class="result correct">Correct! (Question <%= @latest_response.question.number %>)</p>
    <% elsif @current_question && @latest_response.question_id == @current_question.id %>
      <p class="result incorrect">Not quite.</p>
      <% if @latest_response.feedback %>
        <p class="choice-feedback"><%= @latest_response.feedback %></p>
      <% end %>
    <% end %>
  <% end %>

  <% if @session.ended? %>
    <p>Session has ended.</p>
  <% elsif @current_question.nil? %>
    <p>You have completed all questions in this session.</p>
  <% else %>
    <p>Question <%= @current_question.number %> of <%= @session.ordered_questions.count %></p>
    <p><strong><%= @current_question.body %></strong></p>
    <%= form_with url: session_responses_path(@session), method: :post do |form| %>
      <% @current_question.choices.each do |choice| %>
        <label><%= radio_button_tag :choice_id, choice.id, false, required: true %> <%= choice.body %></label>
      <% end %>
      <%= form.submit "Submit" %>
    <% end %>
  <% end %>
  <% unless @session.ended? %>
    <p>
      <%= button_to "Leave session", leave_session_path(@session), method: :post, class: "btn btn-danger" %>
    </p>
  <% end %>
<% end %>